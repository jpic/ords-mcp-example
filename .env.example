# =============================================================================
# Auth0 (required) — see docs/AUTH0_SETUP.md
# =============================================================================

# Tenant domain only (no https://), e.g. dev-xxxx.us.auth0.com
AUTH0_DOMAIN=

# MUST equal OpenCode MCP URL and Auth0 API Identifier exactly:
AUTH0_AUDIENCE=http://127.0.0.1:8080/mcp

# Native application Client ID (OpenCode PKCE — no secret required)
AUTH0_CLIENT_ID=

# Leave unset for Native + OpenCode. Only for optional M2M test clients:
# AUTH0_CLIENT_SECRET=

# Auth0 reserves JWT claim "roles". Lab uses roles2 (Jeff Smith / ORDS MCP).
# ORDS JSON pointer:
MCP_ROLE_CLAIM=/roles2

# Optional: scripts/test_auth0.py password grant (usually disabled on Native apps)
# AUTH0_TEST_USERNAME=
# AUTH0_TEST_PASSWORD=

# =============================================================================
# Oracle / ORDS
# =============================================================================

ORACLE_PWD=OracleFree123
DB_SERVICE=FREEPDB1
ORDS_MODE=mcp
ORDS_HTTP_PORT=8080
ORDS_ENABLE_HTTPS=false

# MCP pool DB users (must match sql/01_lab_schemas.sql)
MCP_HR_DB_USER=HR_MCP_RO
MCP_HR_DB_PASSWORD=HrMcp_ChangeMe1
MCP_FIN_DB_USER=FIN_MCP_RO
MCP_FIN_DB_PASSWORD=FinMcp_ChangeMe1
MCP_HR_ROLE=POOL.HR
MCP_FIN_ROLE=POOL.FIN
MCP_HR_POOL_NAME=mcp-hr
MCP_FIN_POOL_NAME=mcp-fin
